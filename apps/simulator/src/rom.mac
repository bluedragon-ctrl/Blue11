; The simulator's ROM: 160000-167777, 4 KB, read-only (docs/BLUE11_DISPLAY.md section 11).
; An 8 x 8 font and two routines that draw it. Read them, call them, copy them
; into your own program and change them.
;
; Copyright (c) 2026 the Blue-11 authors. MIT licence (see LICENSE). The font was
; drawn for Blue-11 and is not copied from any other font or ROM.
;
; Calling either routine: R0 = the character, R1 = where its top left pixel goes,
; R2 = the colour. Only the glyph's own pixels are painted. R1 moves on to the next
; cell to the right; the other registers are unchanged.
;     JSR  PC, @#DRAWCH       ; mode 0: R1 is the pixel's address, then R1 + 10
;     JSR  PC, @#DRAWC1       ; mode 1: R1 is the pixel's byte (x even), then R1 + 4

        .=160000
; The jump table: these two addresses stay the same when the routines change.
DRAWCH: JMP  DRAW0              ; 160000: draw a character in mode 0
DRAWC1: JMP  DRAW1              ; 160004: draw a character in mode 1

; DRAW0: mode 0, a byte per pixel, 100 bytes a row.
DRAW0:  MOV  R0, -(SP)          ; keep the registers we use
        MOV  R3, -(SP)
        MOV  R4, -(SP)
        MOV  R5, -(SP)
        BIC  #177600, R0        ; 0-177 only
        ASL  R0
        ASL  R0
        ASL  R0                 ; R0 * 10: the glyph's offset in the font
        ADD  #FONT, R0          ; R0 = the glyph's top row
        MOV  #10, R4            ; 8 rows
1$:     MOVB (R0)+, R3          ; one row of the glyph: bit 7 is the leftmost pixel
        MOV  #10, R5            ; 8 pixels
2$:     ASLB R3                 ; the next pixel into C
        BCC  3$                 ; 0: leave the pixel as it is
        MOVB R2, (R1)           ; 1: paint it
3$:     INC  R1                 ; one pixel to the right
        SOB  R5, 2$             ; the rest of the row
        ADD  #100-10, R1        ; one row down, back to the cell's left edge
        SOB  R4, 1$             ; the next row
        SUB  #1000-10, R1       ; back up 8 rows, and one cell to the right
        MOV  (SP)+, R5          ; put the registers back
        MOV  (SP)+, R4
        MOV  (SP)+, R3
        MOV  (SP)+, R0
        RTS  PC                 ; back to the caller

; DRAW1: mode 1, two pixels per byte (the left one in bits 3-0, the right one in
; bits 7-4), 100 bytes a row. The same steps as DRAW0, two glyph bits per byte.
DRAW1:  MOV  R0, -(SP)          ; keep the registers we use
        MOV  R2, -(SP)
        MOV  R3, -(SP)
        MOV  R4, -(SP)
        MOV  R5, -(SP)
        BIC  #177760, R2        ; R2 = the colour, 0-17: a left pixel
        MOV  R2, -(SP)          ; and on the stack, moved up 4 bits:
        ASL  (SP)
        ASL  (SP)
        ASL  (SP)
        ASL  (SP)               ; (SP) = the colour as a right pixel
        BIC  #177600, R0        ; 0-177 only
        ASL  R0
        ASL  R0
        ASL  R0                 ; R0 * 10: the glyph's offset in the font
        ADD  #FONT, R0          ; R0 = the glyph's top row
        MOV  #10, R4            ; 8 rows
1$:     MOVB (R0)+, R3          ; one row of the glyph: bit 7 is the leftmost pixel
        MOV  #4, R5             ; 4 bytes of 2 pixels
2$:     ASLB R3                 ; the left pixel into C
        BCC  3$                 ; 0: leave it
        BICB #17, (R1)          ; 1: clear bits 3-0
        BISB R2, (R1)           ; and paint it
3$:     ASLB R3                 ; the right pixel into C
        BCC  4$                 ; 0: leave it
        BICB #360, (R1)         ; 1: clear bits 7-4
        BISB (SP), (R1)         ; and paint it
4$:     INC  R1                 ; the next byte: two pixels to the right
        SOB  R5, 2$             ; the rest of the row
        ADD  #100-4, R1         ; one row down, back to the cell's left edge
        SOB  R4, 1$             ; the next row
        SUB  #1000-4, R1        ; back up 8 rows, and one cell to the right
        TST  (SP)+              ; drop the colour
        MOV  (SP)+, R5          ; put the registers back
        MOV  (SP)+, R4
        MOV  (SP)+, R3
        MOV  (SP)+, R2
        MOV  (SP)+, R0
        RTS  PC                 ; back to the caller

; The font: character c is at FONT + c*10, 8 bytes, top row first, bit 7 the
; leftmost pixel. Codes 0-37 and 177 are blank.
        .=162000
FONT:
